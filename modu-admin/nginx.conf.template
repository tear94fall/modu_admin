# 백오피스 정적 서빙 + 게이트웨이 프록시.
# 브라우저는 같은 출처만 부르므로 게이트웨이 CORS 설정 없이 동작한다.
#
# 이 파일은 템플릿이다. 공식 nginx 이미지가 기동할 때 envsubst 로 /etc/nginx/conf.d/default.conf 를 만든다
# (정의된 환경변수만 바꾸므로 $host 같은 nginx 변수는 그대로 남는다).
#
# 게이트웨이 주소는 이름으로만 적고 nginx 가 주기적으로 다시 조회한다(upstream server ... resolve, nginx 1.27.3+).
# 예전에는 기동 때 한 번만 IP 로 바꿔 붙잡아서, 게이트웨이가 재배포돼 IP 가 바뀌면 모든 API 가 502 였고(2026-09-24),
# nginx 가 뜰 때 게이트웨이가 아직 없으면 nginx 자체가 기동에 실패했다. 이제 기동 순서·재배포와 무관하다.
# DNS 서버는 하드코딩하지 않는다: NGINX_ENTRYPOINT_LOCAL_RESOLVERS(Dockerfile) 로 컨테이너의 /etc/resolv.conf 를 읽어
# NGINX_LOCAL_RESOLVERS 에 넣는다(Docker 면 127.0.0.11, 쿠버네티스면 클러스터 DNS).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream gateway {
    zone gateway 64k;
    server gateway-service:8000 resolve;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 게이트웨이 라우트 prefix 만 넘긴다. 나머지는 SPA 라우팅.
    location ~ ^/(auth-service|member-service|chat-service|push-service|storage-service|point-service|commerce-service)/ {
        proxy_pass http://gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 브라우저는 같은 출처 요청에도 Origin 을 붙인다. 게이트웨이 CORS 는 개발 서버 출처만 허용하므로
        # 그대로 넘기면 403 이 난다. 프록시가 같은 출처를 보장하니 Origin 은 지우고 넘긴다.
        proxy_set_header Origin "";
        proxy_read_timeout 60s;
    }

    # 해시가 붙은 빌드 산출물은 오래 캐시해도 된다.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
